#!/usr/bin/env bash
timestamp=$(date +%d_%m_%Y-%I-%M-%S)
dir="$(xdg-user-dir PICTURES)/ScreenShots"
filename="$dir/Screenshot-${timestamp}.png"

[ -d "$dir" ] || mkdir -p "$dir"

if [ "$XDG_SESSION_TYPE" == "wayland" ]; then
  backend="wayland"
else
  backend="x11"
fi

# Función para mostrar una notificación con dunst
show_notification() {
  dunstify --replace=699 -i "$1" "Screenshot" "$2"
}

countdown() {
  for sec in $(seq "$1" -1 1); do
    dunstify -t 1000 --replace=699 -i ~/.config/bspwm/assets/screenshot.svg "Taking shot in : $sec"
    sleep 1
  done
}

take_screenshot() {
  local mode=$1
  local msg=$2

  case $backend in
  wayland)
    case $mode in
    now) grim "$filename" ;;
    sel) grim -g "$(slurp)" "$filename" ;;
    active)
      # Nota: La captura de ventana activa en Wayland depende del compositor.
      # Este ejemplo es para Sway/Hyprland.
      if command -v hyprctl >/dev/null; then
        grim -g "$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')" "$filename"
      else
        grim "$filename" # Fallback a pantalla completa
      fi
      ;;
    esac
    wl-copy <"$filename"
    ;;
  x11)
    case $mode in
    now) maim -u "$filename" ;;
    sel) maim -u -s "$filename" ;;
    active) maim -u -i "$(xdotool getactivewindow)" "$filename" ;;
    esac
    xclip -selection clipboard -t image/png -i "$filename"
    ;;
  esac

  show_notification "$filename" "$msg"
}

case $1 in
--now)
  take_screenshot "now" "Screenshot saved and copied to clipboard"
  ;;
--in10)
  countdown 10
  take_screenshot "now" "Scheduled capture taken after 10 seconds"
  ;;
--sel)
  take_screenshot "sel" "Selected area saved and copied to clipboard"
  ;;
--active)
  take_screenshot "active" "Active window saved and copied to clipboard"
  ;;
*)
  take_screenshot "now" "Screenshot saved and copied to clipboard"
  ;;
esac
